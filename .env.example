# ==============================================================================
# DREAM TERUS (COMMERCE OS) — RUNTIME ENVIRONMENT CONFIGURATION
# ==============================================================================
# Chế độ dữ liệu (VITE_DATA_MODE):
# - 'mock' (Mặc định): Chạy 100% Mock Engine nội bộ. Không cần cài đặt database,
#   không cần Supabase, không bị bất kỳ lỗi schema nào. Clone về là chạy ngay!
# - 'supabase': Kết nối Database PostgreSQL/Supabase thật (Staging / Production).
# ==============================================================================
VITE_DATA_MODE=mock

# Các thông số dưới đây CHỈ BẮT BUỘC khi bạn chuyển sang VITE_DATA_MODE=supabase:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
